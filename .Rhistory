# GAUSSIAN GLMM 3
# going to try log transforming some of the continuous fixed effect predictors:
df_clean$log_distance_to_water_km <- log(df_clean$distance_to_water_km)
# GAUSSIAN GLMM 3
# going to try log transforming some of the continuous fixed effect predictors:
glmm_gauss3 <- glmmTMB(
log(body_mass) ~ landscape +
vegetation +
lion_presence +
log(distance_to_water_km) +
average_annual_rainfall_mm +
log(predator_density_per_sq_km) +
# park as random effect - each gets own intercept
(1 | park) +
# observer as random effect - each gets own intercept
(1 | observer),
data = df_clean,
family = gaussian()
)
AIC(glmm_gamma, glmm_gauss2, glmm_gauss3)
fit_model_data <- data.frame(
"Predicted" = exp(predict(glmm_gauss3, type = "response")),
"Observed" = df_clean$body_mass
)
# plot predicted vs observed with 1:1 line
ggplot(fit_model_data,
aes(x = Observed, y = Predicted)) +
# each point (x) = observed, (y) = model prediction
geom_point() +
# add linear regression of observed:fitted
geom_smooth(method = lm,
col = "red",
se = FALSE) +
# add 1:1 linear regression to plot to check main regression
geom_abline(intercept = 0) +
ggtitle("Predicted vs. Observed for glmm_gauss2 vs. df_clean. Red is artificial 1:1 regression") +
theme_lucid()
# GAUSSIAN GLMM 3
# going to try log transforming some of the continuous fixed effect predictors:
glmm_gauss3 <- glmmTMB(
log(body_mass) ~ landscape +
vegetation +
lion_presence +
distance_to_water_km +
average_annual_rainfall_mm +
predator_density_per_sq_km +
# park as random effect - each gets own intercept
(1 | park) +
# observer as random effect - each gets own intercept
(1 | observer) +
(1 + distance_to_water_km | park),
data = df_clean,
family = gaussian()
)
AIC(glmm_gamma, glmm_gauss2, glmm_gauss3)
# GAUSSIAN GLMM 3
# going to try log transforming some of the continuous fixed effect predictors:
glmm_gauss3 <- glmmTMB(
log(body_mass) ~ landscape +
vegetation +
lion_presence +
distance_to_water_km +
average_annual_rainfall_mm +
predator_density_per_sq_km +
# park as random effect - each gets own intercept
(1 | park) +
# observer as random effect - each gets own intercept
(1 | observer) +
(1 + distance_to_water_km | park),
data = df_clean,
family = gaussian()
)
# GAUSSIAN GLMM 3
# going to try log transforming some of the continuous fixed effect predictors:
glmm_gauss3 <- glmmTMB(
log(body_mass) ~ landscape +
vegetation +
lion_presence +
distance_to_water_km +
average_annual_rainfall_mm +
predator_density_per_sq_km +
landscape*vegetation +
# park as random effect - each gets own intercept
(1 | park) +
# observer as random effect - each gets own intercept
(1 | observer),
data = df_clean,
family = gaussian()
)
AIC(glmm_gamma, glmm_gauss2, glmm_gauss3)
check_model(glmm_gauss3)
check_model(glmm_gauss2)
check_model(glmm_gauss3)
summary(glmm_gauss3)
check_model(glmm_gauss3)
# GAUSSIAN GLMM 3
# going to try lto add some biologically meaningful interactions
glmm_gauss3 <- glmmTMB(
log(body_mass) ~ landscape +
vegetation +
lion_presence +
distance_to_water_km +
average_annual_rainfall_mm +
predator_density_per_sq_km +
# add landscape-vegetation interaction:
landscape*vegetation +
distance_to_water_km*predator_density_per_sq_km +
# park as random effect - each gets own intercept
(1 | park) +
# observer as random effect - each gets own intercept
(1 | observer),
data = df_clean,
family = gaussian()
)
check_model(glmm_gauss3)
summary(glmm_gauss3)
AIC(glmm_gamma, glmm_gauss2, glmm_gauss3)
